SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
MAIL_USE_SSL=true
MAIL_USE_STARTTLS=false
MAIL_TIMEOUT_SECONDS=20
# Incoming website inquiries: anfrage@... -> hallo@...
SMTP_REQUEST_USER=
SMTP_REQUEST_PASSWORD=
SMTP_REQUEST_PASSWORD_FILE=
MAIL_REQUEST_FROM_ADDRESS=anfrage@munich-bike-rental.de
MAIL_REQUEST_TO_ADDRESS=hallo@munich-bike-rental.de

# Admin booking actions and replies: usually hallo@...
SMTP_MAIN_USER=
SMTP_MAIN_PASSWORD=
SMTP_MAIN_PASSWORD_FILE=
MAIL_MAIN_FROM_ADDRESS=hallo@munich-bike-rental.de

# Optional IMAP access for thread lookup and moving sent rejection mails.
IMAP_MAIN_HOST=
IMAP_MAIN_PORT=993
IMAP_MAIN_SECURE=true
IMAP_MAIN_USER=
IMAP_MAIN_PASSWORD=
IMAP_MAIN_PASSWORD_FILE=
IMAP_MAIN_SENT_MAILBOX=Sent
IMAP_MAIN_REJECTED_MAILBOX=Abgelehnt
IMAP_MAIN_PENDING_MAILBOX=Ausstehend
# Internal poller: call POST /api/internal/sync-incoming-mail once per minute.
MAIL_SYNC_TOKEN=
# Internal outbox dispatcher: call POST /api/internal/dispatch-mail-outbox once per minute.
OUTBOX_DISPATCH_TOKEN=
# Bootstrap-Link für den ersten Admin (im Produktivbetrieb als 0600-Datei, nicht im Log).
BOOTSTRAP_ADMIN_INVITATION_FILE=/data/bootstrap-admin-invitation.txt
# Nur für einen kontrollierten lokalen Hand-off auf true setzen; produktiv nicht aktivieren.
BOOTSTRAP_ADMIN_PRINT_LINK=false
# Server-side OpenAI access for the incoming-mail action check.
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=middle
SITE_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
# At least 32 random bytes; the placeholder is rejected by the application.
CALENDAR_FEED_TOKEN=
DATABASE_URL=./data/bikerental.db
BETTER_AUTH_URL=http://localhost:3000
# Create with: openssl rand -base64 48
BETTER_AUTH_SECRET=
APP_IMAGE=ghcr.io/porzel-net/munich-bike-rental:latest
APP_PIDS_LIMIT=128
APP_MEMORY_LIMIT=512m
APP_CPU_LIMIT=1.0
DEV_ALLOWED_ORIGINS=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Stripe-Secret-Key: nur serverseitig verwenden, niemals mit NEXT_PUBLIC_ prefix.
STRIPE_SECRET_KEY=sk_test_...

# Nevlo Bank API: nur serverseitig verwenden, niemals mit NEXT_PUBLIC_ prefix.
NEVLO_CLIENT_ID=
NEVLO_ACCESS_TOKEN=
NEVLO_REFRESH_TOKEN=
# Optional: overrides BETTER_AUTH_SECRET for encrypted persistence of rotated tokens.
NEVLO_TOKEN_ENCRYPTION_KEY=
# Bei einer erneuten OAuth-Autorisierung den alten Datensatz vorübergehend manuell aus der DB entfernen.
# Optional: ansonsten werden alle verbundenen Nevlo-Konten synchronisiert.
NEVLO_ACCOUNT_ID=
# Optionaler ISO-Datumsfilter für den Import.
NEVLO_SYNC_DATE_FROM=
NEVLO_SYNC_DATE_TO=
# Automatischer Nevlo-Poller läuft serverseitig beim Start und danach alle fünf Minuten.
# Für den Angebots-Checkout zusätzlich im Stripe-Sandbox-Webhook hinterlegen.
STRIPE_WEBHOOK_SECRET=whsec_...
