SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
MAIL_USE_SSL=true
MAIL_USE_STARTTLS=false
MAIL_TIMEOUT_SECONDS=20
SMTP_USER=
SMTP_PASSWORD=
# Production: path inside the container to a read-only mounted secret file.
SMTP_PASSWORD_FILE=
MAIL_FROM_ADDRESS=anfrage@munich-bike-rental.de
MAIL_TO_ADDRESS=hallo@munich-bike-rental.de
SITE_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=./data/bikerental.db
BETTER_AUTH_URL=http://localhost:3000
# Create with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Required only for the one-time `pnpm auth:bootstrap-admin` command.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
APP_IMAGE=ghcr.io/porzel-net/munich-bike-rental:latest
APP_PIDS_LIMIT=128
APP_MEMORY_LIMIT=512m
APP_CPU_LIMIT=1.0
DEV_ALLOWED_ORIGINS=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
